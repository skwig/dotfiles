{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "leader": "ctrl+space",
    "session.list": ["<leader>l", "<leader>i"],
    "prompt.images.view": false
  },
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "animations": true,
  "tabs": {
    "scope": "global"
  }
}
